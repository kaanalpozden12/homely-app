{
  "expo": {
    "name": "Loftrobin",
    "slug": "loftrobin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "loftrobin",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.loftrobin.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Loftrobin needs your photos so you can add pictures to your listings."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DCEFE9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.loftrobin.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Loftrobin",
      "shortName": "Loftrobin",
      "themeColor": "#0F6B57",
      "backgroundColor": "#F7F5F0",
      "description": "Buy and sell second-hand furniture and household items in London, from neighbours who speak your language."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Loftrobin needs your photos so you can add pictures to your listings."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
